---
import Layout from "../layouts/Layout.astro";
import {
    Terminal,
    FileCode2,
    Bot,
    Copy,
    Check,
    ExternalLink,
    ArrowRight,
    ShieldCheck,
    Zap,
    Cpu,
    Sparkles,
    Search,
    CheckCircle2,
    FileSearch,
    ChevronRight,
    GitCompare,
    EyeOff,
    Menu,
    X,
} from "lucide-astro";
import globalInstructionTemplate from "../assets/skimGlobalInstructionTemplate.md?raw";
import metaInstallInstructions from "../assets/skimMetaInstallInstructions.md?raw";

const repoUrl = "https://github.com/benedictjohannes/programming-helper-utils";

const systemPromptSnippet = globalInstructionTemplate.trim();
const metaPrompt = `${metaInstallInstructions.trim()}\n\n${systemPromptSnippet}`;

const installCommands = [
    {
        lang: "Go",
        binary: "skim-go",
        desc: "Built with standard go/parser (zero deps)",
        cmd: "go install github.com/benedictjohannes/programming-helper-utils/skim-go@latest",
        badge: "Go 1.22+",
    },
    {
        lang: "Rust",
        binary: "skim-rs",
        desc: "Powered by ra_ap_syntax (Rust Analyzer engine)",
        cmd: "cargo install skim-rs",
        badge: "crates.io",
    },
    {
        lang: "TypeScript / JS",
        binary: "skim-ts",
        desc: "TypeScript Compiler API + Vue, Svelte, Astro SFCs",
        cmd: "npm install -g skim-ts",
        badge: "npm",
    },
    {
        lang: "Python",
        binary: "skim-py",
        desc: "Built with standard ast parser (zero deps)",
        cmd: "pip install skim-python",
        badge: "PyPI",
    },
];
---

<Layout title="Programmer Toolkit — Developer & AI Agent Utilities">
    <!-- Top Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-zinc-950/90 border-b border-zinc-800/80">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
                <img
                    src="/favicon.svg"
                    alt="Encelerate Logo"
                    class="w-8 h-8 rounded-lg group-hover:scale-105 transition-transform"
                />
                <div class="flex flex-col">
                    <span class="font-bold tracking-tight text-zinc-100 flex items-center gap-1.5 text-sm sm:text-base">
                        Programmer Toolkit
                        <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700/60 font-medium">
                            OSS
                        </span>
                    </span>
                    <span class="text-[11px] text-zinc-400 font-mono hidden sm:inline">
                        by Encelerate
                    </span>
                </div>
            </a>

            <!-- Desktop Nav: Exactly 2 Items + GitHub -->
            <nav class="hidden md:flex items-center gap-3 text-sm font-medium">
                <a
                    href="#skim"
                    class="px-3 py-1.5 rounded-md text-zinc-300 hover:text-white hover:bg-zinc-800/60 transition"
                >
                    Skim Tools
                </a>

                <div class="flex items-center rounded-lg border border-zinc-800 bg-zinc-900/60 p-0.5">
                    <a
                        href="#coding-transcript"
                        class="px-3 py-1 rounded-md text-zinc-300 hover:text-white hover:bg-zinc-800/80 transition"
                    >
                        Coding Transcript
                    </a>
                    <a
                        href="/coding-transcript.html"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="p-1 rounded-md text-sky-400 hover:text-sky-300 bg-sky-950/60 hover:bg-sky-900/80 border border-sky-800/40 transition ml-0.5"
                        title="Open Coding Transcript in new tab"
                        aria-label="Open Coding Transcript in new tab"
                    >
                        <ExternalLink class="w-3.5 h-3.5" />
                    </a>
                </div>

                <a
                    href={repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition ml-2"
                    aria-label="GitHub Repository"
                >
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                        ></path>
                    </svg>
                </a>
            </nav>

            <!-- Mobile Menu Toggle Button -->
            <div class="flex items-center md:hidden">
                <button
                    id="mobile-menu-toggle"
                    type="button"
                    class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                >
                    <Menu class="w-6 h-6 icon-menu" />
                    <X class="w-6 h-6 icon-close hidden" />
                </button>
            </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div
            id="mobile-menu"
            class="hidden md:hidden border-t border-zinc-800/80 bg-zinc-950/95 px-4 py-4 space-y-3"
        >
            <a
                href="#skim"
                class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-medium text-zinc-300 hover:text-white hover:bg-zinc-900 transition"
            >
                Skim Tools
            </a>

            <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-zinc-900/70 border border-zinc-800">
                <a
                    href="#coding-transcript"
                    class="mobile-nav-link text-sm font-medium text-zinc-300 hover:text-white transition"
                >
                    Coding Transcript
                </a>
                <a
                    href="/coding-transcript.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-mono font-medium text-sky-400 bg-sky-950/80 hover:bg-sky-900 border border-sky-800/50 transition"
                >
                    <span>Launch App</span>
                    <ExternalLink class="w-3 h-3" />
                </a>
            </div>

            <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-zinc-400 hover:text-white hover:bg-zinc-900 transition"
            >
                <span>GitHub Repository</span>
                <ExternalLink class="w-4 h-4 text-zinc-500" />
            </a>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20 space-y-28">
        <!-- Hero Section -->
        <section class="text-center space-y-6 pt-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-700/70 text-xs font-mono text-zinc-300">
                <Sparkles class="w-3.5 h-3.5 text-sky-400" />
                <span>Context-lean tooling for the autonomous coding era</span>
            </div>

            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
                High-signal developer tools <br class="hidden sm:inline" />
                built for{" "}
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-teal-300 to-indigo-400">
                    AI coding agents
                </span>
                .
            </h1>

            <p class="text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                Stop burning token limits on 3,000-line test suites and
                sprawling files. Inspect code surgically with{" "}
                <code class="text-sky-300 font-mono text-sm px-1.5 py-0.5 bg-zinc-900 rounded">
                    skim-*
                </code>{" "}
                and audit sessions locally with{" "}
                <code class="text-sky-300 font-mono text-sm px-1.5 py-0.5 bg-zinc-900 rounded">
                    coding-transcript
                </code>
                .
            </p>

            <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
                <a
                    href="#skim"
                    class="px-5 py-3 rounded-xl bg-white text-zinc-950 font-semibold text-sm hover:bg-zinc-200 transition flex items-center gap-2 shadow-lg shadow-white/5"
                >
                    <Zap class="w-4 h-4 text-sky-600 fill-current" />
                    <span>Explore skim-* Tools</span>
                </a>
                <a
                    href="/coding-transcript.html"
                    class="px-5 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-zinc-100 font-semibold text-sm hover:bg-zinc-800/90 transition flex items-center gap-2 group"
                >
                    <span>Launch Transcript Viewer</span>
                    <ArrowRight class="w-4 h-4 text-zinc-400 group-hover:translate-x-0.5 transition-transform" />
                </a>
            </div>

            <!-- Quick Stats / Badges -->
            <div class="pt-8 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
                <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800">
                    <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">
                        Context Tax
                    </div>
                    <div class="text-xl font-bold text-sky-400">
                        80–95% Saved
                    </div>
                    <div class="text-xs text-zinc-400 mt-1">
                        Filters test suites & body noise
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800">
                    <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">
                        Architectural Scope
                    </div>
                    <div class="text-xl font-bold text-zinc-200">
                        4 Languages
                    </div>
                    <div class="text-xs text-zinc-400 mt-1">
                        Go, Rust, TS/JS, Python
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800">
                    <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">
                        Transcript Privacy
                    </div>
                    <div class="text-xl font-bold text-teal-400">
                        100% Client-Side
                    </div>
                    <div class="text-xs text-zinc-400 mt-1">
                        Zero network telemetry
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800">
                    <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">
                        Tested Agent Runtimes
                    </div>
                    <div class="text-xl font-bold text-indigo-400">
                        Antigravity & OpenCode
                    </div>
                    <div class="text-xs text-zinc-400 mt-1">
                        Full JSON & JSONL parsing
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 1: skim-* -->
        <section id="skim" class="space-y-12 scroll-mt-24">
            <div class="border-t border-zinc-800/80 pt-16">
                <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-2">
                    <Terminal class="w-4 h-4" />
                    <span>TOOL SUITE 01</span>
                </div>
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                            skim-*
                        </h2>
                        <p class="text-zinc-400 mt-2 max-w-2xl">
                            Language-specific, AST-resilient code navigators.
                            Two surgical primitives (
                            <code class="text-zinc-200 font-mono">glance</code>{" "}
                            and{" "}
                            <code class="text-zinc-200 font-mono">block</code>)
                            that break the infinite agent reading loop.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a
                            href={`${repoUrl}/blob/main/Design.Skim.md`}
                            target="_blank"
                            class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/70 transition"
                        >
                            <span>Design Specification</span>
                            <ExternalLink class="w-3.5 h-3.5" />
                        </a>
                    </div>
                </div>
            </div>

            <!-- Problem vs Solution Comparison -->
            <div class="grid md:grid-cols-2 gap-6">
                <div class="p-6 rounded-2xl bg-zinc-900/40 border border-red-950/60 relative overflow-hidden">
                    <div class="flex items-center gap-2 text-red-400 font-mono text-xs uppercase tracking-wider mb-3">
                        <EyeOff class="w-4 h-4" />
                        <span>The Agent Context Tax (Default behavior)</span>
                    </div>
                    <ul class="space-y-3 text-sm text-zinc-400">
                        <li class="flex items-start gap-2.5">
                            <span class="text-red-400 font-bold">✕</span>
                            <span>
                                <strong>Context Exhaustion:</strong> Dumping
                                1,000–5,000 line files burns token limits and
                                causes attention drift.
                            </span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-red-400 font-bold">✕</span>
                            <span>
                                <strong>The Test Bloat Trap:</strong> Test files
                                and mocks make up 50–75% of codebases, flooding
                                prompts with noise.
                            </span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-red-400 font-bold">✕</span>
                            <span>
                                <strong>Grep Truncation:</strong> Arbitrary line
                                windows cut off signatures, docstrings, or
                                closing braces.
                            </span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-red-400 font-bold">✕</span>
                            <span>
                                <strong>Infinite Read Loop:</strong> File A
                                references File B references File C — draining
                                tool allowances.
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="p-6 rounded-2xl bg-zinc-900/40 border border-emerald-950/60 relative overflow-hidden">
                    <div class="flex items-center gap-2 text-emerald-400 font-mono text-xs uppercase tracking-wider mb-3">
                        <CheckCircle2 class="w-4 h-4" />
                        <span>The skim-* Two-Command Mental Model</span>
                    </div>
                    <div class="space-y-4 text-sm text-zinc-300">
                        <div class="p-3 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
                            <div class="font-mono text-xs text-sky-400 font-semibold mb-1">
                                1. Survey Structure: glance
                            </div>
                            <p class="text-xs text-zinc-400 leading-relaxed">
                                AST outline displaying declarations, signatures,
                                and types. Test files & implementation bodies
                                are stripped by default.
                            </p>
                            <div class="mt-2 font-mono text-xs text-zinc-300 bg-zinc-900 px-2 py-1 rounded">
                                skim-&lt;lang&gt; glance . -s -f keyword
                            </div>
                        </div>

                        <div class="p-3 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
                            <div class="font-mono text-xs text-sky-400 font-semibold mb-1">
                                2. Surgical Extraction: block
                            </div>
                            <p class="text-xs text-zinc-400 leading-relaxed">
                                AST-bounded verbatim code extraction for a
                                specific function, struct, or method (
                                <code class="text-zinc-200">Type.Method</code>).
                                Delivers complete docstrings & signature.
                            </p>
                            <div class="mt-2 font-mono text-xs text-zinc-300 bg-zinc-900 px-2 py-1 rounded">
                                skim-&lt;lang&gt; block src/auth.ts
                                User.validate --raw
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Installation Grid -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white">
                    Manual Installation
                </h3>
                <p class="text-sm text-zinc-400">
                    Install the binary for your active language ecosystem:
                </p>
                <div class="grid sm:grid-cols-2 gap-4">
                    {installCommands.map((item) => (
                        <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700 transition flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <div class="flex items-center gap-2">
                                        <span class="font-semibold text-white text-sm">
                                            {item.lang}
                                        </span>
                                        <span class="font-mono text-xs text-sky-400">
                                            ({item.binary})
                                        </span>
                                    </div>
                                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700/50">
                                        {item.badge}
                                    </span>
                                </div>
                                <p class="text-xs text-zinc-400 mb-3">
                                    {item.desc}
                                </p>
                            </div>

                            <div class="relative group mt-2">
                                <pre class="bg-zinc-950 p-2.5 rounded-lg border border-zinc-800/80 font-mono text-xs text-zinc-300 overflow-x-auto pr-10"><code>{item.cmd}</code></pre>
                                <button
                                    type="button"
                                    class="copy-btn absolute right-2 top-2 p-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition"
                                    data-clipboard={item.cmd}
                                    aria-label="Copy command"
                                >
                                    <Copy class="w-3.5 h-3.5 icon-copy" />
                                    <Check class="w-3.5 h-3.5 icon-check hidden text-emerald-400" />
                                </button>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- SECTION 2: Agent Instructions & Meta Prompt -->
        <section id="agent-setup" class="space-y-12 scroll-mt-24">
            <div class="border-t border-zinc-800/80 pt-16">
                <div class="flex items-center gap-2 text-xs font-mono text-indigo-400 mb-2">
                    <Bot class="w-4 h-4" />
                    <span>CONFIGURATION & AUTOMATION</span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                    Supercharge Your Coding Agent
                </h2>
                <p class="text-zinc-400 mt-2 max-w-2xl">
                    Equip Antigravity, Claude Code, Cursor, or OpenCode with the
                    skim mental model so they stop ingesting massive files
                    automatically.
                </p>
            </div>

            <!-- Feature B: Meta-Prompt Copy Box -->
            <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-zinc-900/60 to-zinc-900 border border-indigo-700/40 relative overflow-hidden shadow-2xl">
                <div class="absolute -right-12 -top-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-6">
                    <div class="space-y-2">
                        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-indigo-900/50 border border-indigo-700/50 text-[11px] font-mono text-indigo-300">
                            <Bot class="w-3.5 h-3.5" />
                            <span>Zero-Effort Automated Setup</span>
                        </div>
                        <h3 class="text-xl sm:text-2xl font-bold text-white">
                            Or have your agent install and configure it for you
                        </h3>
                        <p class="text-sm text-zinc-300 max-w-xl">
                            Paste this meta-prompt directly into your coding
                            assistant chat. The agent will inspect your
                            machine's package managers, install the binaries you
                            need, and wire up your global system instructions.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="copy-btn flex-shrink-0 inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition shadow-lg shadow-indigo-600/30 active:scale-98"
                        data-clipboard={metaPrompt}
                    >
                        <Copy class="w-4 h-4 icon-copy" />
                        <Check class="w-4 h-4 icon-check hidden text-white" />
                        <span>Copy Agent Instructions</span>
                    </button>
                </div>

                <div class="relative">
                    <div class="text-[11px] font-mono text-zinc-400 mb-2 flex items-center justify-between">
                        <span>PROMPT PREVIEW</span>
                        <span class="text-zinc-500">
                            Ready to paste into chat
                        </span>
                    </div>
                    <pre class="bg-zinc-950/90 p-4 rounded-xl border border-zinc-800 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre-wrap leading-relaxed max-h-48"><code>{metaPrompt}</code></pre>
                </div>
            </div>

            <!-- Feature A: System Instructions Snippet -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-white">
                            Manual Agent System Prompt Snippet
                        </h3>
                        <p class="text-xs text-zinc-400">
                            Paste this into your global agent instructions (
                            <code class="text-zinc-300 font-mono">
                                ~/.gemini/GEMINI.md
                            </code>
                            ,{" "}
                            <code class="text-zinc-300 font-mono">
                                ~/.claude/CLAUDE.md
                            </code>
                            , or other global rule file).
                        </p>
                    </div>
                    <button
                        type="button"
                        class="copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-mono transition"
                        data-clipboard={systemPromptSnippet}
                    >
                        <Copy class="w-3.5 h-3.5 icon-copy" />
                        <Check class="w-3.5 h-3.5 icon-check hidden text-emerald-400" />
                        <span>Copy Snippet</span>
                    </button>
                </div>

                <pre class="bg-zinc-950 p-4 sm:p-5 rounded-2xl border border-zinc-800 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre-wrap leading-relaxed"><code>{systemPromptSnippet}</code></pre>
            </div>
        </section>

        <!-- SECTION 3: Coding Transcript -->
        <section id="coding-transcript" class="space-y-12 scroll-mt-24">
            <div class="border-t border-zinc-800/80 pt-16">
                <div class="flex items-center gap-2 text-xs font-mono text-teal-400 mb-2">
                    <FileSearch class="w-4 h-4" />
                    <span>TOOL SUITE 02</span>
                </div>
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                            Coding Transcript Viewer
                        </h2>
                        <p class="text-zinc-400 mt-2 max-w-2xl">
                            A lightweight, standalone single-file HTML viewer
                            for AI agent conversation transcripts. Review,
                            debug, and share agent trajectories with total
                            privacy.
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a
                            href="/coding-transcript.html"
