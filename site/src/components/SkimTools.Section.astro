---
import {
    Terminal,
    EyeOff,
    CheckCircle2,
    Sparkles,
    ExternalLink,
    Bot,
    Copy,
    Check,
} from "lucide-astro";
import globalInstructionTemplate from "../assets/skimGlobalInstructionTemplate.md?raw";
import metaInstallInstructions from "../assets/skimMetaInstallInstructions.md?raw";

interface Props {
    repoUrl: string;
}

const { repoUrl } = Astro.props;

const systemPromptSnippet = globalInstructionTemplate.trim();
const metaPrompt = `${metaInstallInstructions.trim()}\n\n${systemPromptSnippet}`;

const installCommands = [
    {
        lang: "Go",
        binary: "skim-go",
        desc: "Built with standard go/parser (zero deps)",
        cmd: "go install github.com/benedictjohannes/programming-helper-utils/skim-go@latest",
        badge: "Go 1.22+",
    },
    {
        lang: "Rust",
        binary: "skim-rs",
        desc: "Powered by ra_ap_syntax (Rust Analyzer engine)",
        cmd: "cargo install skim-rs",
        badge: "crates.io",
    },
    {
        lang: "TypeScript / JS",
        binary: "skim-ts",
        desc: "TypeScript Compiler API + Vue, Svelte, Astro SFCs",
        cmd: "npm install -g skim-ts",
        badge: "npm",
    },
    {
        lang: "Python",
        binary: "skim-py",
        desc: "Built with standard ast parser with parso syntax error fallback",
        cmd: "pip install skim-python",
        badge: "PyPI",
    },
];
---

<section id="skim" class="space-y-12 scroll-mt-24">
    <div class="border-t border-zinc-800/80 pt-16">
        <div class="flex items-center gap-2 text-xs font-mono text-sky-400 mb-2">
            <Terminal class="w-4 h-4" />
            <span>TOOL SUITE 01</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                    Skim Tools
                </h2>
                <p class="text-zinc-400 mt-2 max-w-2xl">
                    Language-specific, AST-resilient code navigators.
                    Two surgical primitives (
                    <code class="text-zinc-200 font-mono">glance</code>{" "}
                    and{" "}
                    <code class="text-zinc-200 font-mono">block</code>)
                    that break the infinite agent reading loop.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <a
                    href={`${repoUrl}/blob/master/Design.Skim.md`}
                    target="_blank"
                    class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/70 transition"
                >
                    <span>Design Specification</span>
                    <ExternalLink class="w-3.5 h-3.5" />
                </a>
            </div>
        </div>
    </div>

    <!-- Problem vs Solution Comparison -->
    <div class="grid md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-zinc-900/40 border border-red-950/60 relative overflow-hidden">
            <div class="flex items-center gap-2 text-red-400 font-mono text-xs uppercase tracking-wider mb-3">
                <EyeOff class="w-4 h-4" />
                <span>The Agent Context Tax (Default behavior)</span>
            </div>
            <ul class="space-y-3 text-sm text-zinc-400">
                <li class="flex items-start gap-2.5">
                    <span class="text-red-400 font-bold">✕</span>
                    <span>
                        <strong>Context Exhaustion:</strong> Dumping
                        1,000–5,000 line files burns token limits and
                        causes attention drift.
                    </span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="text-red-400 font-bold">✕</span>
                    <span>
                        <strong>The Test Bloat Trap:</strong> Test files
                        and mocks make up 50–75% of codebases, flooding
                        prompts with noise.
                    </span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="text-red-400 font-bold">✕</span>
                    <span>
                        <strong>Grep Truncation:</strong> Arbitrary line
                        windows cut off signatures, docstrings, or
                        closing braces.
                    </span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="text-red-400 font-bold">✕</span>
                    <span>
                        <strong>Infinite Read Loop:</strong> File A
                        references File B references File C — draining
                        tool allowances.
                    </span>
                </li>
            </ul>
        </div>

        <div class="p-6 rounded-2xl bg-zinc-900/40 border border-emerald-950/60 relative overflow-hidden">
            <div class="flex items-center gap-2 text-emerald-400 font-mono text-xs uppercase tracking-wider mb-3">
                <CheckCircle2 class="w-4 h-4" />
                <span>The skim-* Two-Command Mental Model</span>
            </div>
            <div class="space-y-4 text-sm text-zinc-300">
                <div class="p-3 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
                    <div class="font-mono text-xs text-sky-400 font-semibold mb-1">
                        1. glance (Survey high level)
                    </div>
                    <p class="text-xs text-zinc-400">
                        Map types, functions, methods, and interfaces without
                        bodies. Filters out test noise automatically.
                    </p>
                    <code class="mt-2 block font-mono text-[11px] text-zinc-300 bg-zinc-900/80 p-2 rounded border border-zinc-800">
                        skim-&lt;lang&gt; glance -s &lt;path&gt;
                    </code>
                </div>
                <div class="p-3 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
                    <div class="font-mono text-xs text-emerald-400 font-semibold mb-1">
                        2. block (Surgical zoom)
                    </div>
                    <p class="text-xs text-zinc-400">
                        Extract exact AST-bounded declaration blocks with
                        comments and gutters. Never misses a closing brace.
                    </p>
                    <code class="mt-2 block font-mono text-[11px] text-zinc-300 bg-zinc-900/80 p-2 rounded border border-zinc-800">
                        skim-&lt;lang&gt; block &lt;file&gt; &lt;target&gt;
                    </code>
                </div>
            </div>
        </div>
    </div>

    <!-- AST-Aware Guarantee Banner -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-sky-950/40 via-zinc-900 to-indigo-950/40 border border-sky-800/40 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
            <h3 class="text-lg font-bold text-white">
                AST-Resilient Extraction Engine
            </h3>
            <p class="text-xs text-zinc-400 max-w-2xl">
                Unlike regex or grep line windows, skim commands parse
                syntactic trees. You get complete class/method bodies, comments,
                and parameter signatures every single time.
            </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-zinc-300 bg-zinc-950/60 px-4 py-2 rounded-xl border border-zinc-800 self-start md:self-auto">
            <Sparkles class="w-3.5 h-3.5 text-amber-400" />
            <span>Zero Guesswork Parsing</span>
        </div>
    </div>

    <!-- Installation Matrix -->
    <div class="space-y-4">
        <div>
            <h3 class="text-xl font-bold text-white">
                Supported Ecosystems & Installation
            </h3>
            <p class="text-xs text-zinc-400 mt-1">
                Install only the binaries you need for your stack.
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 min-w-0">
            {
                installCommands.map((item) => (
                    <div class="p-5 rounded-2xl bg-zinc-900/50 border border-zinc-800 hover:border-zinc-700 transition flex flex-col justify-between space-y-4 min-w-0 max-w-full overflow-hidden">
                        <div class="space-y-2 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-xs font-mono text-sky-400 truncate">
                                    {item.binary}
                                </span>
                                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700/60 shrink-0">
                                    {item.badge}
                                </span>
                            </div>
                            <h4 class="font-bold text-white text-base">
                                {item.lang}
                            </h4>
                            <p class="text-xs text-zinc-400 leading-relaxed">
                                {item.desc}
                            </p>
                        </div>
                        <div class="pt-2 min-w-0">
                            <button
                                type="button"
                                class="copy-btn w-full max-w-full text-left p-2.5 rounded-lg bg-zinc-950 border border-zinc-800 hover:border-zinc-700 text-xs font-mono text-zinc-300 transition flex items-center justify-between group min-w-0 overflow-hidden"
                                data-clipboard={item.cmd}
                            >
                                <span class="truncate min-w-0 flex-1">{item.cmd}</span>
                                <Copy class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-300 flex-shrink-0 ml-2 icon-copy" />
                                <Check class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0 ml-2 hidden icon-check" />
                            </button>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Agent Integration Section Header -->
    <div class="border-t border-zinc-800/80 pt-16">
        <div class="flex items-center gap-2 text-xs font-mono text-indigo-400 mb-2">
            <Bot class="w-4 h-4" />
            <span>AGENT INSTRUCTIONS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            How to Teach Your Coding Agent
        </h2>
        <p class="text-zinc-400 mt-2 max-w-2xl">
            Equip Antigravity, Claude Code, Codex or OpenCode with the
            skim mental model so they stop ingesting massive files
            automatically.
        </p>
    </div>

    <!-- Feature B: Meta-Prompt Copy Box -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-zinc-900/60 to-zinc-900 border border-indigo-700/40 relative overflow-hidden shadow-2xl">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-6">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-indigo-900/50 border border-indigo-700/50 text-[11px] font-mono text-indigo-300">
                    <Bot class="w-3.5 h-3.5" />
                    <span>Zero-Effort Automated Setup</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-white">
                    Or have your agent install and configure it for you
                </h3>
                <p class="text-sm text-zinc-300 max-w-xl">
                    Paste this meta-prompt directly into your coding
                    assistant chat. The agent will inspect your
                    machine's package managers, install the binaries you
                    need, and wire up your global system instructions.
                </p>
            </div>

            <button
                type="button"
                class="copy-btn flex-shrink-0 inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition shadow-lg shadow-indigo-600/30 active:scale-98"
                data-clipboard={metaPrompt}
            >
                <Copy class="w-4 h-4 icon-copy" />
                <Check class="w-4 h-4 icon-check hidden text-white" />
                <span>Copy Agent Instructions</span>
            </button>
        </div>

        <div class="relative">
            <div class="text-[11px] font-mono text-zinc-400 mb-2 flex items-center justify-between">
                <span>PROMPT PREVIEW</span>
                <span class="text-zinc-500">
                    Ready to paste into chat
                </span>
            </div>
            <pre class="bg-zinc-950/90 p-4 rounded-xl border border-zinc-800 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre-wrap leading-relaxed max-h-48"><code>{metaPrompt}</code></pre>
        </div>
    </div>

    <!-- Feature A: System Instructions Snippet -->
    <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h3 class="text-lg font-semibold text-white">
                    Manual Agent System Prompt Snippet
                </h3>
                <p class="text-xs text-zinc-400">
                    Paste this into your global agent instructions (
                    <code class="text-zinc-300 font-mono">
                        ~/.gemini/GEMINI.md
                    </code>
                    ,{" "}
                    <code class="text-zinc-300 font-mono">
                        ~/.claude/CLAUDE.md
                    </code>
                    , or other global rule file).
                </p>
            </div>
            <button
                type="button"
                class="copy-btn inline-flex items-center justify-center self-start sm:self-auto gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-mono transition"
                data-clipboard={systemPromptSnippet}
            >
                <Copy class="w-3.5 h-3.5 icon-copy" />
                <Check class="w-3.5 h-3.5 icon-check hidden text-emerald-400" />
                <span>Copy Snippet</span>
            </button>
        </div>

        <pre class="bg-zinc-950 p-4 sm:p-5 rounded-2xl border border-zinc-800 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre-wrap leading-relaxed"><code>{systemPromptSnippet}</code></pre>
    </div>
</section>
