---
import {
    FileSearch,
    ExternalLink,
    ShieldCheck,
    Cpu,
    GitCompare,
    ChevronRight,
    Search,
    FileCode2,
} from "lucide-astro";

interface Props {
    repoUrl: string;
}

const { repoUrl } = Astro.props;
---

<section id="coding-transcript" class="space-y-12 scroll-mt-24">
    <div class="border-t border-zinc-800/80 pt-16">
        <div class="flex items-center gap-2 text-xs font-mono text-teal-400 mb-2">
            <FileSearch class="w-4 h-4" />
            <span>TOOL SUITE 02</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                    Coding Transcript Viewer
                </h2>
                <p class="text-zinc-400 mt-2 max-w-2xl">
                    A lightweight, standalone single-file HTML viewer
                    for AI agent conversation transcripts. Review,
                    debug, and share agent trajectories with total
                    privacy.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <a
                    href={`${repoUrl}/blob/master/Design.CodingTranscript.md`}
                    target="_blank"
                    class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/70 transition"
                >
                    <span>Design Specification</span>
                    <ExternalLink class="w-3.5 h-3.5" />
                </a>
            </div>
        </div>
    </div>

    <!-- Feature Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-teal-950/60 border border-teal-800/60 flex items-center justify-center text-teal-400">
                <ShieldCheck class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                100% Client-Side Privacy
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                All parsing, search, and diffing execute strictly inside
                your local browser runtime. Zero logs, zero telemetry,
                zero uploads.
            </p>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-950/60 border border-indigo-800/60 flex items-center justify-center text-indigo-400">
                <Cpu class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                Tested on real transcripts
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                Fully tested and optimized for Antigravity and OpenCode sessions. More are coming.
            </p>
        </div>

        <!-- Card 3 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-sky-950/60 border border-sky-800/60 flex items-center justify-center text-sky-400">
                <GitCompare class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                Interactive Diffs & Terminals
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                Side-by-side Target vs. Replacement diff visualization
                for tool edits, syntax highlighting across 9 languages,
                and terminal styling.
            </p>
        </div>

        <!-- Card 4 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-amber-950/60 border border-amber-800/60 flex items-center justify-center text-amber-400">
                <ChevronRight class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                Recursive Collapsing
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                Deep collapse conversation turns, XML tag bubbles (
                <code class="text-zinc-300 font-mono">
                    &lt;USER_REQUEST&gt;
                </code>
                , etc.), and individual tool calls to keep reviews fast.
            </p>
        </div>

        <!-- Card 5 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-950/60 border border-purple-800/60 flex items-center justify-center text-purple-400">
                <Search class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                Real-Time Search & Cycling
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                Real-time regex & full-text match navigation with{" "}
                <kbd class="px-1.5 py-0.5 bg-zinc-800 rounded text-[10px]">
                    Enter
                </kbd>{" "}
                /{" "}
                <kbd class="px-1.5 py-0.5 bg-zinc-800 rounded text-[10px]">
                    Shift+Enter
                </kbd>
                , smooth scrolling, and flash highlights.
            </p>
        </div>

        <!-- Card 6 -->
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-pink-950/60 border border-pink-800/60 flex items-center justify-center text-pink-400">
                <FileCode2 class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-white text-base">
                Single-File HTML Distribution
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
                Compiles JS, CSS, and icons into a single self-contained{" "}
                <code class="text-zinc-300 font-mono">
                    dist/index.html
                </code>{" "}
                with zero CDN or external dependencies.
            </p>
        </div>
    </div>

    <!-- App Banner Callout -->
    <div class="p-8 rounded-3xl bg-zinc-900/80 border border-zinc-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center md:text-left">
            <div class="text-xs font-mono text-zinc-400 uppercase tracking-wider">
                Ready to inspect your sessions?
            </div>
            <div class="text-xl font-bold text-white">
                Drag and drop your agent transcript file right now
            </div>
            <div class="text-xs text-zinc-400">
                Supports Antigravity JSONL, OpenCode JSON, Claude Code,
                and ChatGPT dumps.
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a
                href="/coding-transcript.html"
                class="px-6 py-3 rounded-xl bg-white text-zinc-950 font-bold text-sm hover:bg-zinc-200 transition flex items-center gap-2 shadow-lg"
            >
                <span>Open Transcript Viewer</span>
                <ExternalLink class="w-4 h-4" />
            </a>
        </div>
    </div>
</section>
