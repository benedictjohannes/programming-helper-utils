#!/usr/bin/env python3
"""skim-rust-file: Fast Rust outline & block extractor without test bloat.

Accepts two subcommands: `glance` and `block`.
Run without arguments to print self-contained documentation and workflow.
"""

import argparse
import glob
import os
import re
import sys
from typing import Dict, List, Optional, Set, Tuple

USAGE_DOC = """\
skim-rust-file: Fast Rust outline & block extractor without test bloat.
Prefer this over reading entire .rs files to preserve token context.

Usage:
  skim-rust-file glance [options] <path>...
  skim-rust-file block  [options] <file> <target>

glance:
  Outline structure, signatures, and line ranges across files/directories.

  Usage:
    skim-rust-file glance [options] <path>...

  Arguments:
    <path>...                 One or more .rs files, directories, or globs

  Options:
    -s, --signatures          Show declarations & types without function bodies
    -d, --details             Show struct fields and enum variants
    -u, --uses, --imports     Display top-level use statements
    -f, --filter <text>       Filter items containing <text> (case-insensitive, repeatable)
    -t, --include-tests       Include mod tests and #[test] functions

  Examples:
    skim-rust-file glance src/lib.rs
    skim-rust-file glance src/ -s -u
    skim-rust-file glance src/ -s -f "Config" -f "parse"

block:
  Extract verbatim code block for a struct, enum, trait, or method.

  Usage:
    skim-rust-file block [options] <file> <target>

  Arguments:
    <file>                    Path to the .rs file
    <target>                  Name of struct, enum, trait, fn, or Type::method

  Options:
    -t, --include-tests       Search inside test modules
    --raw                     Omit line number gutter

  Examples:
    skim-rust-file block src/lib.rs DsdInputConfig
    skim-rust-file block src/lib.rs Settings::explain_for_input_rate
    skim-rust-file block src/lib.rs Settings::explain --raw -t

  Disambiguation:
    If multiple items match (e.g. from_settings), qualify Type::method or use line ranges.

Agent Operational Workflow:
  1. Glance first:   skim-rust-file glance <path> -s
  2. Locate logic:   skim-rust-file glance <path> -f <keyword>
  3. Inspect code:   Use `block <file> <Type::method>`, or read reported line spans (Lxx-Lyy)
"""


def compute_line_starts(text: str) -> List[int]:
    starts = [0]
    for idx, ch in enumerate(text):
        if ch == "\n":
            starts.append(idx + 1)
    return starts


def pos_to_line(line_starts: List[int], pos: int) -> int:
    import bisect

    return bisect.bisect_right(line_starts, pos)


class RustItem:
    def __init__(
        self,
        kind: str,
        name: str,
        start_line: int,
        end_line: int,
        start_pos: int,
        end_pos: int,
        raw_header: str,
        parent: Optional["RustItem"] = None,
        is_test: bool = False,
    ):
        self.kind = kind
        self.name = name
        self.start_line = start_line
        self.end_line = end_line
        self.start_pos = start_pos
        self.end_pos = end_pos
        self.raw_header = raw_header.strip()
        self.parent = parent
        self.is_test = is_test
        self.children: List["RustItem"] = []
        self.fields_or_variants: List[str] = []

    @property
    def qualified_name(self) -> str:
        if self.parent and self.parent.kind == "impl":
            return f"{self.parent.name}::{self.name}"
        return self.name

    def __repr__(self):
        return f"RustItem({self.kind} {self.qualified_name} L{self.start_line}-L{self.end_line})"


class ParsedRustFile:
    def __init__(
        self,
        filename: str,
        text: str,
        items: List[RustItem],
        test_ranges: List[Tuple[int, int]],
        uses: List[str],
    ):
        self.filename = filename
        self.text = text
        self.items = items
        self.test_ranges = test_ranges
        self.uses = uses
        self.total_lines = text.count("\n") + (
            1 if text and not text.endswith("\n") else 0
        )


def mask_comments_and_strings(text: str) -> str:
    """Mask string literals and comments with spaces to keep byte positions accurate."""
    n = len(text)
    masked = list(text)
    idx = 0

    while idx < n:
        # Line comment
        if idx + 1 < n and text[idx : idx + 2] == "//":
            c_start = idx
            while idx < n and text[idx] != "\n":
                masked[idx] = " "
                idx += 1
            continue
        # Block comment (handles nesting)
        elif idx + 1 < n and text[idx : idx + 2] == "/*":
            c_start = idx
            idx += 2
            nesting = 1
            while idx < n and nesting > 0:
                if idx + 1 < n and text[idx : idx + 2] == "/*":
                    nesting += 1
                    idx += 2
                elif idx + 1 < n and text[idx : idx + 2] == "*/":
                    nesting -= 1
                    idx += 2
                else:
                    idx += 1
            for j in range(c_start, min(idx, n)):
                if text[j] != "\n":
                    masked[j] = " "
            continue
        # Raw string r#"..."#
        elif (
            text[idx] == "r"
            and idx + 1 < n
            and (text[idx + 1] == '"' or text[idx + 1] == "#")
        ):
            r_start = idx
            idx += 1
            hashes = 0
            while idx < n and text[idx] == "#":
                hashes += 1
                idx += 1
            if idx < n and text[idx] == '"':
                idx += 1
                delim = '"' + ("#" * hashes)
                d_len = len(delim)
                while idx < n and text[idx : idx + d_len] != delim:
                    idx += 1
                if idx < n:
                    idx += d_len
                for j in range(r_start, min(idx, n)):
                    if text[j] != "\n":
                        masked[j] = " "
                continue
        # Normal string "..."
        elif text[idx] == '"':
            s_start = idx
            idx += 1
            while idx < n:
                if text[idx] == "\\" and idx + 1 < n:
                    idx += 2
                elif text[idx] == '"':
                    idx += 1
                    break
                elif text[idx] == "\n":
                    break
                else:
                    idx += 1
            for j in range(s_start, min(idx, n)):
                if text[j] != "\n":
                    masked[j] = " "
            continue
        # Char literal '.'
        elif text[idx] == "'":
            c_start = idx
            idx += 1
            if idx < n and text[idx] == "\\" and idx + 1 < n:
                idx += 2
            elif idx < n:
                idx += 1
            if idx < n and text[idx] == "'":
                idx += 1
            for j in range(c_start, min(idx, n)):
                if text[j] != "\n":
                    masked[j] = " "
            continue
        idx += 1

    return "".join(masked)


def find_brace_block(clean_text: str, start_brace_pos: int) -> int:
    """Find the matching closing brace position."""
    n = len(clean_text)
    depth = 0
    p = start_brace_pos
    while p < n:
        if clean_text[p] == "{":
            depth += 1
        elif clean_text[p] == "}":
            depth -= 1
            if depth == 0:
                return p
        p += 1
    return n - 1


def parse_rust_file(
    filename: str, text: str, include_tests: bool = False
) -> ParsedRustFile:
    line_starts = compute_line_starts(text)
    clean_text = mask_comments_and_strings(text)

    # 1. Detect uses / imports (top-level only, ignoring inside mod tests)
    use_re = re.compile(
        r"^[ \t]*(?:pub(?:\s*\([^)]*\))?\s+)?use\s+([^;]+);", re.MULTILINE
    )
    uses = []
    for m in use_re.finditer(clean_text):
        m_start = m.start()
        raw_stmt = text[m_start : m.end()].strip()
        raw_stmt = " ".join(raw_stmt.split())
        uses.append((pos_to_line(line_starts, m_start), raw_stmt))

    # 2. Identify test blocks
    test_ranges: List[Tuple[int, int]] = []

    item_re = re.compile(
        r"((?:#\[[^\]]*\]\s*)*)"
        r"((?:pub(?:\s*\([^)]*\))?\s+)?"
        r'(?:(?:async|const|unsafe|extern(?:\s*"[^"]*")?)\s+)*'
        r"(struct|enum|trait|type|fn|impl|mod))\b",
        re.MULTILINE,
    )

    raw_items: List[Tuple[int, int, int, str, str, str, bool]] = []

    for match in item_re.finditer(clean_text):
        attrs_str = match.group(1)
        full_kw_prefix = match.group(2)
        kind = match.group(3)
        m_start = match.start()
        kw_pos = match.start(3)

        is_cfg_test = (
            "#[cfg(test)]" in attrs_str
            or "#[test]" in attrs_str
            or "#[tokio::test]" in attrs_str
            or "#[rstest]" in attrs_str
        )
        if kind == "mod" and (
            "mod tests" in full_kw_prefix or "mod test " in text[kw_pos : kw_pos + 40]
        ):
            is_cfg_test = True

        next_open = clean_text.find("{", match.end())
        next_semi = clean_text.find(";", match.end())

        if next_open != -1 and (next_semi == -1 or next_open < next_semi):
            header_end = next_open
            block_end = find_brace_block(clean_text, next_open)
        elif next_semi != -1:
            header_end = next_semi
            block_end = next_semi
        else:
            header_end = match.end()
            block_end = match.end()

        start_line = pos_to_line(line_starts, m_start)
        end_line = pos_to_line(line_starts, block_end)

        if is_cfg_test:
            test_ranges.append((start_line, end_line))

        decl_start = match.start(2)
        header = text[decl_start:header_end].strip()
        header = " ".join(header.split())

        after_kw = clean_text[kw_pos + len(kind) : header_end].strip()
        name_match = re.search(r"([A-Za-z0-9_]+)", after_kw)
        name = name_match.group(1) if name_match else ""

        if kind == "impl":
            clean_impl = re.sub(r"\s+where\b.*", "", header).strip()
            clean_impl = re.sub(
                r"^(?:pub\s+)?impl(?:\s*<[^>]*>)?\s+", "", clean_impl
            ).strip()
            name = clean_impl if clean_impl else "impl"

        raw_items.append((m_start, block_end, kw_pos, kind, name, header, is_cfg_test))

    def in_test_range(l: int) -> bool:
        if include_tests:
            return False
        for s, e in test_ranges:
            if s <= l <= e:
                return True
        return False

    filtered_uses = [u[1] for u in uses if include_tests or not in_test_range(u[0])]

    parsed_items: List[Tuple[int, int, RustItem]] = []
    for m_start, block_end, kw_pos, kind, name, header, is_test in raw_items:
        s_line = pos_to_line(line_starts, m_start)
        e_line = pos_to_line(line_starts, block_end)

        if not include_tests and (is_test or in_test_range(s_line)):
            continue

        item = RustItem(
            kind=kind,
            name=name,
            start_line=s_line,
            end_line=e_line,
            start_pos=m_start,
            end_pos=block_end,
            raw_header=header,
            is_test=is_test,
        )

        if kind in ("struct", "enum"):
            open_b = clean_text.find("{", kw_pos)
            if open_b != -1 and open_b < block_end:
                body_clean = clean_text[open_b + 1 : block_end]
                body_orig = text[open_b + 1 : block_end]
                if kind == "struct":
                    item.fields_or_variants = extract_struct_fields(
                        body_orig, body_clean
                    )
                elif kind == "enum":
                    item.fields_or_variants = extract_enum_variants(
                        body_orig, body_clean
                    )

        parsed_items.append((m_start, block_end, item))

    parsed_items.sort(key=lambda x: (x[0], -x[1]))

    root_items: List[RustItem] = []
    stack: List[Tuple[int, int, RustItem]] = []

    for s, e, item in parsed_items:
        while stack and stack[-1][1] < e:
            stack.pop()

        if stack:
            parent = stack[-1][2]
            item.parent = parent
            parent.children.append(item)
        else:
            root_items.append(item)

        if item.kind in ("impl", "trait", "mod"):
            stack.append((s, e, item))

    return ParsedRustFile(
        filename=filename,
        text=text,
        items=root_items,
        test_ranges=test_ranges,
        uses=filtered_uses,
    )


def extract_struct_fields(orig_body: str, clean_body: str) -> List[str]:
    fields = []
    depth = 0
    current = []
    for c_char, o_char in zip(clean_body, orig_body):
        if c_char in "([{<":
            depth += 1
        elif c_char in ")]}>":
            depth = max(0, depth - 1)
        elif c_char == "," and depth == 0:
            f = "".join(current).strip()
            if f:
                fields.append(" ".join(f.split()))
            current = []
            continue
        current.append(o_char)
    last = "".join(current).strip()
    if last:
        fields.append(" ".join(last.split()))

    cleaned = []
    for f in fields:
        f_clean = re.sub(r"#\[[^\]]*\]", "", f).strip()
        if f_clean:
            cleaned.append(f_clean)
    return cleaned


def extract_enum_variants(orig_body: str, clean_body: str) -> List[str]:
    return extract_struct_fields(orig_body, clean_body)


def collect_all_items(items: List[RustItem]) -> List[RustItem]:
    res = []
    for it in items:
        res.append(it)
        if it.children:
            res.extend(collect_all_items(it.children))
    return res


def match_item_filters(item: RustItem, text: str, filters: List[str]) -> bool:
    if not filters:
        return True
    block_text = text[item.start_pos : item.end_pos + 1].lower()
    return all(f.lower() in block_text for f in filters)


# ---------------------------------------------------------------------------
# glance subcommand
# ---------------------------------------------------------------------------


def run_glance(args):
    files: List[str] = []
    for pattern in args.targets:
        if os.path.isdir(pattern):
            for root, _, fnames in os.walk(pattern):
                for fn in fnames:
                    if fn.endswith(".rs"):
                        files.append(os.path.normpath(os.path.join(root, fn)))
        elif "*" in pattern or "?" in pattern:
            matched = glob.glob(pattern, recursive=True)
            for m in matched:
                if m.endswith(".rs") and os.path.isfile(m):
                    files.append(os.path.normpath(m))
        elif os.path.isfile(pattern):
            files.append(os.path.normpath(pattern))
        else:
            sys.stderr.write(f"Warning: path not found: {pattern}\n")

    files = sorted(list(dict.fromkeys(files)))
    if not files:
        sys.stderr.write("Error: no .rs files found matching input.\n")
        sys.exit(1)

    for idx, filepath in enumerate(files):
        if idx > 0:
            print("\n" + "=" * 70 + "\n")

        try:
            with open(filepath, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
        except OSError as e:
            sys.stderr.write(f"Error reading {filepath}: {e}\n")
            continue

        parsed = parse_rust_file(filepath, content, include_tests=args.include_tests)

        test_info = ""
        if parsed.test_ranges and not args.include_tests:
            tr_desc = ", ".join(f"{s}..{e}" for s, e in parsed.test_ranges)
            test_info = f" [tests skipped: {tr_desc}]"
        print(f"=== {filepath} ({parsed.total_lines} lines){test_info} ===")

        if args.uses:
            if parsed.uses:
                print("\nImports:")
                for u in parsed.uses:
                    print(f"  {u}")
            else:
                print("\nImports: (none)")

        def render_tree(item_list: List[RustItem], indent: str = "  "):
            for it in item_list:
                matches_filter = match_item_filters(it, content, args.filter or [])
                child_matches = any(
                    match_item_filters(ch, content, args.filter or [])
                    for ch in it.children
                )

                if not (matches_filter or child_matches):
                    continue

                span = f"L{it.start_line}-L{it.end_line}"
                if it.kind == "impl":
                    label = f"{it.raw_header}"
                elif args.signatures:
                    label = f"{it.raw_header}"
                else:
                    label = f"{it.kind} {it.name}"

                print(f"{indent}{span:<12} {label}")

                if it.fields_or_variants and (args.signatures or args.details):
                    f_indent = indent + "    "
                    for fv in it.fields_or_variants:
                        print(f"{f_indent}| {fv}")

                if it.children:
                    render_tree(it.children, indent + "  ")

        print("\nOutline:")
        render_tree(parsed.items)


# ---------------------------------------------------------------------------
# block subcommand
# ---------------------------------------------------------------------------


def run_block(args):
    filepath = args.file
    target = args.target

    if not os.path.exists(filepath):
        sys.stderr.write(f"Error: file not found: {filepath}\n")
        sys.exit(1)

    with open(filepath, "r", encoding="utf-8", errors="replace") as f:
        content = f.read()

    parsed = parse_rust_file(filepath, content, include_tests=args.include_tests)
    all_items = collect_all_items(parsed.items)

    target_lower = target.lower()
    matches: List[RustItem] = []

    if "::" in target:
        type_part, method_part = [p.strip().lower() for p in target.split("::", 1)]
        for it in all_items:
            if it.name.lower() == method_part and it.parent:
                parent_name = it.parent.name.lower()
                if type_part in parent_name:
                    matches.append(it)
    else:
        for it in all_items:
            if it.name.lower() == target_lower:
                matches.append(it)

        if not matches:
            for it in all_items:
                if (
                    target_lower in it.name.lower()
                    or target_lower in it.raw_header.lower()
                ):
                    matches.append(it)

    if not matches:
        sys.stderr.write(f"Error: block '{target}' not found in {filepath}\n")
        sys.exit(2)

    if len(matches) > 1:
        sys.stderr.write(
            f"Ambiguous target '{target}' matched {len(matches)} candidates in {filepath}:\n"
        )
        for idx, m in enumerate(matches, 1):
            parent_ctx = f" (in {m.parent.kind} {m.parent.name})" if m.parent else ""
            sys.stderr.write(
                f"  {idx}) L{m.start_line}-L{m.end_line:<5} {m.kind} {m.qualified_name}{parent_ctx}\n"
            )
        sys.stderr.write(
            "\nTip: Disambiguate with `Type::method` (e.g. `AlsaOutputConfig::from_settings`) or read line range directly.\n"
        )
        sys.exit(3)

    chosen = matches[0]
    src_lines = content.splitlines()
    block_lines = src_lines[chosen.start_line - 1 : chosen.end_line]

    print(
        f"// {filepath} :: {chosen.raw_header} (lines {chosen.start_line}..{chosen.end_line})"
    )
    if args.raw:
        print("\n".join(block_lines))
    else:
        for idx, l in enumerate(block_lines):
            print(f"{chosen.start_line + idx:5d} | {l}")


# ---------------------------------------------------------------------------
# CLI Argument Parsing
# ---------------------------------------------------------------------------


def main():
    if len(sys.argv) <= 1:
        print(USAGE_DOC.strip())
        sys.exit(0)

    parser = argparse.ArgumentParser(
        prog="skim-rust-file",
        description="Fast Rust source outline and code block extractor without test bloat.",
    )
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # glance subcommand
    p_glance = subparsers.add_parser(
        "glance",
        help="Inspect Rust structure, signatures, fields, and imports without reading entire files.",
    )
    p_glance.add_argument(
        "targets",
        nargs="+",
        help="One or more Rust files, directories, or globs (e.g. `crates/audigma-settings/src`)",
    )
    p_glance.add_argument(
        "-s",
        "--signatures",
        action="store_true",
        help="Show full function signatures and struct/enum definitions without function bodies",
    )
    p_glance.add_argument(
        "-d",
        "--details",
        action="store_true",
        help="Show struct fields and enum variants in the outline",
    )
    p_glance.add_argument(
        "-u",
        "--uses",
        "--imports",
        dest="uses",
        action="store_true",
        help="Display top-level `use` import statements",
    )
    p_glance.add_argument(
        "-f",
        "--filter",
        action="append",
        help="Only display items whose code contains this substring (can be repeated for AND matching)",
    )
    p_glance.add_argument(
        "-t",
        "--include-tests",
        action="store_true",
        help="Include test modules (`mod tests`) and #[test] functions",
    )
    p_glance.set_defaults(func=run_glance)

    # block subcommand
    p_block = subparsers.add_parser(
        "block",
        help="Extract the exact definition of a struct, enum, trait, impl, or method.",
    )
    p_block.add_argument(
        "file",
        help="Path to the Rust (.rs) file",
    )
    p_block.add_argument(
        "target",
        help="Name of the struct, enum, trait, fn, or qualified `Type::method` to extract",
    )
    p_block.add_argument(
        "-t",
        "--include-tests",
        action="store_true",
        help="Include test modules when searching for target",
    )
    p_block.add_argument(
        "--raw",
        action="store_true",
        help="Print raw code without line numbers gutter",
    )
    p_block.set_defaults(func=run_block)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
